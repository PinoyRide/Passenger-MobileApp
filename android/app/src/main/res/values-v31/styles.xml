<resources>
  <!-- Android 12 and later draw their own splash before the app: in the launch screen's colour too, so a phone in
       its dark theme never sees a white one (values-night/colors.xml; QA UPD-14, 2026-11-25). -->
  <style name="Theme.App.SplashScreen" parent="AppTheme">
    <item name="android:windowBackground">@color/launch_background</item>
    <item name="android:windowSplashScreenBackground">@color/launch_background</item>
  </style>
</resources>
