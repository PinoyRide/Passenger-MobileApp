{
  "expo": {
    "name": "Pinoy Ride",
    "slug": "pinoy-ride",
    "owner": "gabriel1337",
    "scheme": "pinoyride",
    "version": "1.1.2",
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "react-native-permissions",
        {
          "iosPermissions": ["Camera", "Microphone", "Notifications"]
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "android": {
      "package": "com.pinoyride.customer",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.pinoyride.customer",
      "infoPlist": {
        "NSCameraUsageDescription": "[REASON]",
        "NSMicrophoneUsageDescription": "[REASON]",
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "extra": {
      "eas": {
        "projectId": "54a9fa8f-b623-44ee-883b-c037d09d78af"
      }
    }
  }
}
