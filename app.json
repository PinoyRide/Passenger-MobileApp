{
  "expo": {
    "name": "Pinoy Ride",
    "slug": "pinoy-ride",
    "owner": "gabriel1337",
    "scheme": "pinoyride",
    "version": "2.0.88",
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.5"
          }
        }
      ],
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "Camera",
            "LocationWhenInUse",
            "Notifications"
          ]
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withFirebaseConfigure",
      "./plugins/withPodsForXcode27",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Pinoy Ride uses the camera to take your profile photo and a photo of your ID.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pinoy Ride uses your location to set your pick-up point and to show riders near you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "android": {
      "package": "com.pinoyride.customer",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.pinoyride.customer",
      "newArchEnabled": false,
      "buildNumber": "96",
      "supportsTablet": false,
      "icon": "./assets/ios-icon-1024.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyAlpSoXuJzvo8uR1qbdtbbbk1sx4MHKIQk"
      },
      "splash": {
        "image": "./src/Assets/Common/Pinoy_Ride.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Pinoy Ride uses the camera to take your profile photo and a photo of your ID.",
        "NSPhotoLibraryUsageDescription": "Pinoy Ride uses your photos when you choose a picture of your ID or send one in a chat.",
        "NSLocationWhenInUseUsageDescription": "Pinoy Ride uses your location to set your pick-up point and to show riders near you.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "gcash",
          "paymaya",
          "maya",
          "topphapp",
          "topphapp-pre",
          "toppay",
          "tel",
          "sms"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "extra": {
      "eas": {
        "projectId": "54a9fa8f-b623-44ee-883b-c037d09d78af"
      }
    }
  }
}
